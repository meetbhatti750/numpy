   "source": [
    "import numpy as np\n",
    "\n",
    "views = np.array([1000, 2500, 4000, 5500, 7000])\n",
    "\n",
    "view_array = views.view()\n",
    "copy_array = views.copy()\n",
    "\n",
    "view_array[0] = 9999\n",
    "copy_array[0] = 8888\n",
    "\n",
    "print(\"Original Array:\", views)\n",
    "print(\"View Array:\", view_array)\n",
    "print(\"Copy Array:\", copy_array)"
   ]
  }
