    "\n",
    "ratings = np.array([4.5, 3.8, np.nan, 4.2, np.nan, 5.0, 3.9, np.nan])\n",
    "\n",
    "missing_count = np.sum(np.isnan(ratings))\n",
    "\n",
    "print(\"Number of missing ratings:\", missing_count)"
