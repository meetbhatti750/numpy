   "source": [
    "import numpy as np\n",
    "\n",
    "views = np.array([1000, 2500, np.nan, 4000, np.inf, 1500, -np.inf])\n",
    "\n",
    "max_finite = np.max(views[np.isfinite(views)])\n",
    "\n",
    "views = np.nan_to_num(views, nan=0, posinf=max_finite, neginf=max_finite)\n",
    "\n",
    "print(views)"
   ]
  }
