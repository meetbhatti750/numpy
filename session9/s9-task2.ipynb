   "source": [
    "import numpy as np\n",
    "\n",
    "prices = np.array([299, 499, 799, 0, 1599, -1, 899])\n",
    "\n",
    "valid_prices = prices[prices > 0]\n",
    "\n",
    "average_price = np.mean(valid_prices)\n",
    "\n",
    "prices[prices <= 0] = average_price\n",
    "\n",
    "print(\"Cleaned Prices:\", prices)"
   ]
  }
 ],
